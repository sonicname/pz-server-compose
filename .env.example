# Copy to .env and fill in:   cp .env.example .env
# .env is git-ignored — never commit real passwords.

# ---- Identity ---------------------------------------------------------------
# Internal name: decides file names (Server/<name>.ini, Saves/Multiplayer/<name>).
# Changing it later = a brand-new world.
SERVER_NAME=pzserver
SERVER_PUBLIC_NAME=PZ with friends
SERVER_DESCRIPTION=Server cho anh em
# false = not in the public server browser; friends join by IP.
SERVER_LISTED=false
MAX_PLAYERS=8

# ---- Passwords (REQUIRED) ---------------------------------------------------
# Password friends type to join. Leave empty = anyone with the IP can join.
SERVER_PASSWORD=change-me
# In-game admin account, created on the very FIRST boot only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too
# Used internally (backup service, pz-rcon). Long random string.
RCON_PASSWORD=change-me-rcon-long-random

# ---- Performance ------------------------------------------------------------
# Java heap. 4 GB VPS -> 3g (+ swap, 2-4 players) | 6 GB -> 4g | 8 GB -> 5g | 16 GB -> 8g.
SERVER_MEMORY=5g
# Container hard cap: SERVER_MEMORY + 2-3g.
CONTAINER_MEMORY_LIMIT=7g
SAVE_EVERY_MINUTES=10
# Freeze world time when nobody is online.
PAUSE_EMPTY=true

# ---- Updates ----------------------------------------------------------------
# true  = update game on every container start (clients auto-update on Steam,
#         and a version mismatch blocks joining, so true is usually right).
# false = keep the installed version (e.g. while waiting for mods to catch up).
AUTO_UPDATE=true
# Empty = public stable branch. "legacy41" = Build 41. Never write "public".
STEAM_BRANCH=

# ---- Safety -----------------------------------------------------------------
# Lua checksum kicks clients whose mod files differ from the server's.
# Only set false if friends get kicked with checksum errors although their mods are in sync.
LUA_CHECKSUM=true
# Backup service: every N minutes, keep the newest K archives in ./backups
BACKUP_INTERVAL_MINUTES=180
BACKUP_KEEP=24
# Game's own backups on start/version change (second safety net)
GAME_BACKUPS_COUNT=5

# ---- Storage ----------------------------------------------------------------
# Default: Docker named volumes (fast; strongly recommended on Windows/WSL2).
# On a Linux host you may bind-mount instead to edit files directly:
#   ZOMBOID_DATA=./data/zomboid
#   SERVER_FILES=./data/server
# Host user/group id that should own bind-mounted files (Linux: `id -u`, `id -g`).
PUID=1000
PGID=1000

# Optional: force the bind IP if the server doesn't answer (rare in Docker).
# BIND_IP=
